# Virtual environment — never commit this, it's huge and machine-specific
venv/

# Python cache files — auto-generated, not needed in Git
__pycache__/
*.pyc
*.pyo
*.pyd

# Data files — auto-generated by the collector, gitignored to avoid committing machine-specific data
data/

# Trained model files — large, machine-specific, reproducible by running train_model.py
models/

# IDE settings
.vscode/
.idea/

# OS junk files
.DS_Store
Thumbs.db

# Environment variables (for secrets — we'll use this later)
.env
